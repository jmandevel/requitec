[import "std", std];

[proc , ()SInt, result,
    result <:= 0;

    // notice how rvalue is nothing. compiler parses inference and interprets this as an indeterminate value. 
    indeterminate :SInt=;

    // if try accessing indeterminate value, this is a compiler error
    // value := indeterminate; // uncomment for a compiler error

    // when you set an indeterminate value for the first time, you use \= operator
    // you can do this even if the type is no_mut.
    indeterminate \= 0;

    // other is an indeterminate platform dependent typed float
    other :Single=;

    // using inits modifier before a scope or chain of scopes to specify that indeterminate values must be initialized within
    // this means that all branches must either set the value or return if in function frame
    inits::other.[reflect]
    [if indeterminate==0,
        other \= 3.14;
    ][else_if indeterminate==1,
        other \= 2.18;
    ][else
        return;
    ];

    unset :SInt=;

    // indeterminates of types without constructors (or builtin primitives) can be initialized in a loop
    inits::unset.[reflect]
    [for 0.<10, var:=value,
        unset \= var;
    ];

    // doing the same for types with a destructor is a compiler error!

    // tuples can have indeterminate elements
    three_ints := {
            :SInt=,
            :SInt=,
            :SInt=
        };

    three_ints->std.at{0}() \= 0;
    three_ints->std.at{1}() \= 1;
    three_ints->std.at{2}() \= 2;
];