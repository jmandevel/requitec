[import "std"];

[class MyClass,];

// This class has stable_address attribute, so it cannnot be moved to a new memory address
[stable_address]
[class MyPinned,];

[entry
  class :\[var]= ..MyClass();
  copy := class;
  reference := class.[borrow];
  reference_to_var := class.\[var][borrow];
  pointer := class.[address];
  pointer_to_var := class.\[var][address];
  copy_value_at_pointer := pointer.[content];
  non_destructive_move := class.\[var][borrow]->..std.extract();
  destructive_move := class.[move];
  // class was dropped because it was moved out of
  pinned :\[var]= ..MyPinned();
  // moved := pinned.[move]; // this move would cause a compiler error because moving to a new memory location and and it has stable_address attribute

  [result] := 0;
];