[import "std", std];

// requite common declarations are lazily evaluated.
// first time they are seen, they are surveyed:
// their name is determined and they are added to symbol table.
// first time they are used, the actual symbol data is evaluated (lazily)
// captures are a way of "saving" eager pre variable values for the later evaluation stage

// pre statements in top scope are evaluated from top to bottom (same time that lazy variables are added to symbol table)
val :mut\= 0;
val = 1;

// this is runtime variable, which has a value captured from mut.
// the value is then used to initialize the variables value when it is lazily evaluated later.
runtime capture::{ num:=val }
common_number := [capture].num;

mangle::main
[proc , ()SInt, result,
    std.print(line=common_number);
    result <:= 0;
];