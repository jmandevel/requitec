[import "std"];

[class Foo, 
    {> [public] string:@[utf8]="Hello, attribute!" <}
];

// Note that the {} enclosing value passed as capture value has no parameter marks!
// This is a tuple value. All members of capture tuple must be constant.
// the compiler enforces that tuples can have only up to one [noname] for any given type.
// if this rule is not followed, this results in a compiler error.
[global][capture]::{ [noname]:=Foo() }
var0 := 1;

[capture]::{ name:="Bob", age:=25 }
var1 := 0;

[function [main], ()[signed_integer],
    [static]
    [if var0.[symbol].[capture].[type].[has Foo],
        std.print(line=var0.[symbol].[capture].[get Foo].string);    
    ];

    std.print(line=
        "Hello, my name is " +> 
        var1.[symbol].[capture].name +> 
        " and I am " +> 
        var1.[symbol].[capture].age +> 
        " years old");

    [result] := 0;
];