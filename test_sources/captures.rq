[import "std"];

[entry
    @capture::{ @public name:="Bob"ascii, @public age:=25s32l }
    var1 := 0s32l;
    .std.print(line="Hello, my name is {var.[symbol].[capture].name} and I am {var.[symbol].[capture].age} years old");

    [class Foo, {> @public string:="Hello, attribute!" <} [constructor];];

    // NOTE: the compiler enforces that tuples can have only up to one unamed property for any given type.
    // if this rule is not followed, this results in a compiler error.
    @capture::{ @public Foo() }
    var0 := 1s32l;

    @static
    [if var0.[symbol].[capture].[has Foo],
        .std.print(line=var0.[symbol].[capture].[get Foo].string);    
    ]
];