[import "std"];

[class Foo, 
    {> [public] string:@[utf8]="Hello, attribute!" <}
];

// Note that the {} enclosing value passed as capture value has no parameter marks!
// This is a special value called a "capture tuple" that can only be passed to a capture.
// All members of capture tuple must be constant.
// the compiler enforces that capture tuples can have only up to one unamed property for any given type.
// if this rule is not followed, this results in a compiler error.
[global][capture]::{ [public] Foo() }
var0 := 1;

[capture]::{ [public] name="Bob", [public] age=25 }
var1 := 0;

[entry
    [static]
    [if ..var0.[symbol].[capture].[has Foo],
        ..std.print(line=..var0.[symbol].[capture].[get Foo].string);    
    ];

    ..std.print(line=
        "Hello, my name is " +> 
        ..var1.[symbol].name +> 
        " and I am " +> 
        ..var1.[symbol].age +> 
        " years old");

    [result] := 0;
];