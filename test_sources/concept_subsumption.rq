[import "std", std];

// A
template::{> Type:FLOAT <}
[proc printType, ( val:Type <)Void,
    std.print(line="Its a float");
];

// B
template::{> Type:INT <}
[proc printType, ( val:Type <)Void,
    std.print(line="Its an integer");
];

// C
template::{> Type:TYPE <}
[proc printType, ( val:Type <)Void,
    std.print(line="Its something");
];

mangle::main
[proc , ()SInt, result,
    printType{SInt32}(); // B
    printType{Single}(); // A
    printType{Bool}();   // C

    result <:= 0;
];