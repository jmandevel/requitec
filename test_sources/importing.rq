// see exporting.rq for what is being imported

[import "exporting", stuff=my_stuff, std];  // notice there is no .rq file extension

[main ()SInt, result,
    stuff.printHelloWorld(); // this function is from exporting.rq
    std.print(line="Goodbye, world!"); // std was imported by exporting.rq
    result <:= 0;
];