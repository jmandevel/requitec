alias std = "std".[import];

// a trip is a list of values surrounded by parenthesis and seperated by commas.
my_trip := (1, 2, 3);

// trips are combinatorial, so the order of items does not matter.
// these trips are equivalent:
my_2_trip := (1, 2);
my_other_2_trip := (2, 1);

// the order of the values when looping over a trip is indeterminate.
// the order may be different every time you compile the source code.
[for my_trip.[trip_range], num:=value,
    std.print(line=num);
];

// nested trips are flattened into one large trip.
trip_of_four := (1, (2, 3), 4);

// every value is a trip. a single value is a trip of one.
my_trip_of_one := 1;

// this is more clear when you surround the value in parenthsis
my_other_trip_of_one := (2);

// looping over a trip of one will give just the single value.
[for my_trip_of_one.[trip_range], num:=value,
    std.print(line=num);
];

// multivalue trips are only valid in comtime code. in runtime code, only trips of one are supported.

// for the types of things trips are used for, look closely at exceptions.rq.