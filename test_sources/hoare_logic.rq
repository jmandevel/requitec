[template]::{| Type:[type_constraint] }
[function divideSquare, 
    \[assert_before]::{b != 0}
    \[assert_after]::{[result] >= 0}
    ( a:Type, b:Type <)Type,
    
    divide_result := a / b;
    square := divide_result * divide_result;
    [result] := square;
];

[entry
    a := ..divideSquare(6, 2);
    
    [result] := 0;
];