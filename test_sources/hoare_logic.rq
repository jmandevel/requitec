template::{ Type:TYPE <}
require::[verify result, 
    result<:=(b != 0);
]
ensure::[verify result,
    result<:=(result >= 0);
]
pure
[procedure divideSquare, ( a:Type, b:Type <)Type, result,
    divide_result := a / b;
    square := divide_result * divide_result;
    result <:= square;
];

[main ()SInt, result,
    a := divideSquare{SInt}(6, 2);
    
    result <:= 0;
];