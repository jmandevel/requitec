template::{ Type:TYPE <}
require::b != 0
ensure::result >= 0
pure
[proc divideSquare, ( a:Type, b:Type <)Type,
    divide_result := a / b;
    square := divide_result * divide_result;
    result <:= square;
];

mangle::main
[proc , ()SInt,
    a := divideSquare{SInt}(6, 2);
    
    result <:= 0;
];