template::{ Type:TYPE <}
require::(b != 0)
ensure::(result >= 0)
pure
[proc divideSquare, ( a:Type, b:Type <) result:Type,
    divide_result := a / b;
    square := divide_result * divide_result;
    result <:= square;
];

mangle::main
[proc , () result:SInt,
    a := divideSquare{SInt}(6, 2);
    
    result <:= 0;
];