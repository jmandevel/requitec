template::{ Type:Symbol <}
constraint::[check result,
    result<:=Type.[is_type];
]
require::[check result, 
    result<:=(b != 0);
]
ensure::[check result,
    result<:=(result >= 0);
]
computes
[procedure divideSquare, ( a:Type, b:Type <)Type, result,
    divide_result := a / b;
    square := divide_result * divide_result;
    result <:= square;
];

[main ()SInt, result,
    a := divideSquare{SInt}(6, 2);
    
    result <:= 0;
];