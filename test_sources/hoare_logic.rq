template::{ Type:Symbol <}
constraint::(Type.[is_type])
require::(b != 0)
ensure::([result] >= 0)
[function divideSquare, ( a:Type, b:Type <)Type,
    divide_[result] := a / b;
    square := divide_[result] * divide_[result];
    [result] <:= square;
];

[main ()SInt,
    a := divideSquare{SInt}(6, 2);
    
    [result] <:= 0;
];