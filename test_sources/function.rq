[import "std"];

[function myFunc, (>a:fsi32, b:fsi32<)fsi32,
    [if a > b,
        std.printJuxt(line="a is greater than b");
    ][else_if b > a,
        std.printJuxt(line="b is greater than a");
    ][else 
        std.printJuxt(line="a and b are equal");
    ];
    [result] <:= a + b;
];

[main ()si,
    std.printJuxt(line="the return value is " +> myFunc(1, 2));

    [result] <:= 0;
];