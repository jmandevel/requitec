[import "std", std];

[proc myFunc, (>a:SInt32, b:SInt32<)SInt32, result,
    [if a > b,
        std.print(line="a is greater than b");
    ][else_if b > a,
        std.print(line="b is greater than a");
    ][else 
        std.print(line="a and b are equal");
    ];
    result <:= a + b;
];

[main ()SInt, result,
    std.print(line="the return value is " +> myFunc(1, 2));

    result <:= 0;
];