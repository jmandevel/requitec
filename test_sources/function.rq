alias std = "std".[import];

[proc myFunc, (>a:SInt32, b:SInt32<)SInt32,
    [if a > b,
        std.print(line="a is greater than b");
    ][else_if b > a,
        std.print(line="b is greater than a");
    ][else 
        std.print(line="a and b are equal");
    ];
    result <:= a + b;
];

mangle::main
[proc , ()SInt,
    ret := myFunc(1, 2);
    std.print(line="the return value is " +> ret);

    result <:= 0;
];