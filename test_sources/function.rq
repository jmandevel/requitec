[import "std"];

[function myFunc, (>a:[fast_signed_integer 32], b:[fast_signed_integer 32]<)[fast_signed_integer 32],
    [if a > b,
        std.printJuxt(line="a is greater than b");
    ][else_if b > a,
        std.printJuxt(line="b is greater than a");
    ][else 
        std.printJuxt(line="a and b are equal");
    ];
    [result] <:= a + b;
];

[function [main], ()[signed_integer],
    std.printJuxt(line="the return value is " +> myFunc(1, 2));

    [result] <:= 0;
];