[import "std"];

anchor::A
static [for 0.<=10, static num:=[value],
    static varname :std.String= std.format(text="VAR" +> num);
    flank::A common capture::{num:=num}
    varname.getSlice().[identify] : si = num.[bake];
];

[main ()si,
    static [for 0.<=10, static num:=[value],
        static varname :std.String= std.format(text="VAR" +> num);
        std.printJuxt(line=varname.getSlice().[bake] +> " is " +> (varname.getSlice().[identify]) +> "!");  
    ];

    [result] <:= 0;
];