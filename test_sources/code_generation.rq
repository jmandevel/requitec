[import "std"];

[anchor]::A
[static][for 0.<=10, num:=[value],
    [static] varname :..std.String= ..std.format(text="VAR" +> num);
    [flank]::A[global][capture]::{num:=num}
    varname.getSlice().[identify] :[signed_integer]= num;
];

[entry
    [static][for 0.<=10, num:=[value],
        [static] varname :..std.String= ..std.format(text="VAR" +> num);
        ..std.print(line=varname.getSlice() +> " is " +> ..(varname.getSlice().[identify]) +> "!");  
    ];

    [result] := 0;
];