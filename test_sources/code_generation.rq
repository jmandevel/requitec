[import "std"];

@static
[for 0.<=10, num:=[value],
    @(num) @global 
    \std.format(text="VAR{num}").getView() :`= index;
];

[entry_point
    @static
    [for 0.<=10, num:=[value], 
        @static
        varname := std.format(text="VAR{num}");
        std.print(line="{varname} is {\varname.getView()}!");        
    ];
];