[import "std"];

@static @label::Loop
[for 0.<=10, num:=[value],
    @static @capture::{num:=num}
    varname := .std.format(text="VAR{[capture].num}");
        @defer varname.destroy();
    @outside::Loop
    \varname :`= index;
];

[entry
    @static
    [for 0.<=10, num:=[value], 
        @static @capture::{num:=num}
        varname := .std.format(text="VAR{[capture].num}");
            @defer varname.destroy();
        .std.print(line="{varname.[borrow]} is {.\varname}!");        
    ];
];