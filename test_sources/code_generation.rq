[import "std"];

@static
[for_each index:, 0.<=10,
    @(index) @global 
    \std.format(text="VAR{index}").[view] :`= index;
];

[entry_point
    @static
    [for_each index:, 0.<=10,
        @static
        varname := std.format(text="VAR{index}");
        std.print(line="{varname} is {\varname.[view]}!");        
    ];
];