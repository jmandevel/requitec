[import "std", std];

anchor::A
static [for 0.<=10, static num:=value,
    static mutname :std.String= std.format(text="VAR" +> num);
    flank::A common capture::{num:=num}
    mutname.getSlice().[identify] : SInt = num.[bake];
];

[main ()SInt, result,
    static [for 0.<=10, static num:=value,
        static mutname :std.String= std.format(text="VAR" +> num);
        std.print(line=mutname.getSlice().[bake] +> " is " +> (mutname.getSlice().[identify]) +> "!");  
    ];

    result <:= 0;
];