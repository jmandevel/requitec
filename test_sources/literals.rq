// NOTE: types in requite can have no implicit conversions, even from literals!
// If you want to change from one numeric type to another you always must cast.

// NOTE: no implicit casting between types even if they share the same underlying type.

[include "string.h"];

[entry
    // type cannot be determined from literal alone!
    // a := 0; // compiler error! can not deduce type of literal

    // can use as reflection to make specific
    // if used, then the literal is treated as the specified type.
    b := 0.[as [signed].[exact_bits 32]]; // signed integer type of exactly 32 bits no matter what

    // can use suffixes to bake type info into the integer itself.
    c :[integer].[exact_bits 8]= 0u;  // [unsigned].[exact_bits 8] // scalar is deduced through substitution
    d :[unsigned].[exact_bits 8]= 0i; // [unsigned].[exact_bits 8] // scalar deduced by inferencing. notice difference from last line
    e :[unsigned].[exact_bits 8]= 0;  // [unsigned].[exact_bits 8] // no suffix! notice difference from last two lines
    f := 0u64;  // [unsigned].[exact_bits 64]
    g := 0uf64;  // [unsigned].[fastest_bits 64]
    h := 0ul128; // [unsigned].[least_bits 128]   // smallest native unsigned integer with at least 128-bits
    // there are special types for working with memory across platforms
    i := 0udx // [unsigned].[exact_index] // unsigned type the size of indexes used for memory address indexing
    j := 0uds // [unsigned].[exact_address] // unsigned type the size of memory addresses

    // can deduce literal type if there is only one valid substitution
    k :[signed].[exact_bits 32]=0; // the variable is defined as se32, so the literal is this as well

    [function doSomething, (>a:[signed].[exact_bits 32]<),];
    [function doSomething, (>a:[binary 32]<),];

    doSomething(0se32); // the literal is of type se32 because this is the only overload that fastest_bits
    // doSomething(0); // compiler error! can not determine which overload.


    // integer literals can be written with an alternate base in the format <base>x<digits>
    // bases in requite can be anything from 2 to 64
    // If the base is over 35, then the digits are case sensitive
    l := 16xDeadBeef; // hexadecimal. casing does not matter
    m := 48xaAbBcCdD; // 48-decimal. capital letters have different values than lowercase
    n := 64xa3BzzZ!fe?3g // 64-decimal. notice that ! and ? are now treated as digits (digit value 62 is ? and 63 is !)
    
    // suffixes in literals with a base go after the base.
    o := 2ue32x1001010111; // suffix makes it [unsigned].[exact_bits 32]

    // underscores among integer literal digits are ignored
    p := 16ue8xF_F;
    q := 1_000_000_000ue64;

    // encoding of codeunit can be specified with a suffix after the closing quote mark
    r := 'B'ascii; // [ascii]

    // strings are null terminated fat pointers to utf8 by default and have suffixes that work the same way
    s := "asdf"ascii; // $null_terminated ^[ascii]

    // if assigned to a mutable variable, the null_terminated attribute goes away unless explicitly reassigned
    // in practice, this limits how you can manipulate the value so you cant break its null_terminated status
    t :$null_terminated `= "asdf"; // $null_terminated `^[utf8]    

    // it stays if a const address is created
    u := "asdf"ascii.[address]; // $null_terminated *[ascii]

    // function arguments can require a null terminated pointer, for example
    [function length, (>ptr:$null_terminated ^[utf8]<),
        [result] := [c].strlen(ptr.[data_address]); // calling strlen from libc
    ];

    // floating point numbers work similarly to integers
    // numbers with a decimal points automatically become floating point
    // however, exact, least, and fastest sizes are not supported
    v := 0.0f32;   // [float].[exact_bits 32]  // explicit float suffix
    w := 128fb16 // [float].[best_bits 16] // may pick a smaller float type if there are none that work

    // it might be beneficial to be explicit about what types of floats you want to use instead
    x := 0binary16;   // [binary].[exact_bits 32]
    y := 100bfloat16; // [bfloat].[exact_bits 32]
];