opaque mangle::myForwardedAdd pure
[proc myForwardedAdd, (> a:Single, b:Single <)Single];

// you have to write the signature again, and it has to be identical
[implement_proc myForwardedAdd.[resolve_proc (> a:Single, b:Single <)Single], result,
    result <:= a + b;
];

mangle::main
[proc , ()SInt, result,
    std.print(
        "the result is " +>
        myForwardedAdd(
            1.0,
            2.0));

    result <:= 0;
];