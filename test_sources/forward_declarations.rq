opaque mangle::myForwardedAdd
[procedure myForwardedAdd, (> a:Single, b:Single <)Single];

// you have to write the signature again, and it has to be identical
[implement_procedure myForwardedAdd, (> a:Single, b:Single <)Single, result,
    result <:= a + b;
];

[main ()SInt, result,
    std.print(
        "the result is " +>
        myForwardedAdd(
            1.0,
            2.0));

    result <:= 0;
];