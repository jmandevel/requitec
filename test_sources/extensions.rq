
[node example,
    template::{> Type:type, LENGTH:USize <}
    [proc getElementCount, ()USize=>Ref@[array LENGTH]@Type, result,
        result <:= LENGTH;
    ];

    [class Foo, public[layout_constructor]; {}];

    [proc bar, ()Void=>$example.Foo,
    
    ];
];

[main ()SInt, result,
    my_array :5@FSInt= [array 0, 1, 2, 3, 4].[of FSInt32];

    // call extension function
    my_array.[borrow]->example.getElementCount().[ignore];
    
    // construct variable of type declared in same table as extension functions
    foo := example.Foo();

    result <:= 0;
];