
[namespace example,
    template::{> Type:TYPE, length:USize <}
    pure
    [procedure getElementCount, ()USize=>Ref@[array length]@Type, result,
        result <:= length;
    ];

    [class Foo, public pure[layout_constructor]; {}];

    pure
    [procedure bar, ()Void=>$example.Foo,
    
    ];
];

mangle::main
[procedure , ()SInt, result,
    my_array :Array::5@FSInt= [array 0, 1, 2, 3, 4].[of FSInt32];

    // call extension function
    my_array.[ref]->example.getElementCount().[ignore];
    
    // construct variable of type declared in same table as extension functions
    foo := example.Foo();

    result <:= 0;
];