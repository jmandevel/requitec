
[namespace example,
    template::{> Type:type, LENGTH:unsigned\Size <}
    [function getElementCount, ()unsigned\Size=>$LENGTH#Type,
        [result] <:= LENGTH;
    ];

    [class Foo, public[layout_constructor]; {}];

    [function bar, ()Void=>$Foo,
    
    ];
];

[main ()Int,
    my_array :5#fast\Int= [array 0, 1, 2, 3, 4].[of fast\Int32];

    // call extension function
    my_array.[borrow]->example.getElementCount().[ignore];
    
    // construct variable of type declared in same table as extension functions
    foo := example.Foo();

    [result] <:= 0;
];