[import "std"];

[enumeration MyEnum, [unsigned_exact_bits 32],
    APPLE  :[signed_fast_bits 32]  = 0;
    ORANGE :[unsigned_fast_bits 32] = 2;
    GRAPE  :[binary32] = 3;
];
.
[entry
    fruit := .MyEnum.APPLE(3);
    [match fruit,
        [with APPLE, apple:=[value].`[borrow], 
            apple = apple + 1;
        ][with ORANGE, orange:=[value].`[borrow],
            orange = orange * 2;
        ][default
            // do nothing!
        ];
    ];
    value :=
        [inline_match fruit,
            [with APPLE, apple:=[value], 
                [out] := apple;
            ][with ORANGE, orange:=[value],
                [out] := orange.[down_cast];
            ][with GRAPE, grape:=[value],
                [out] := grape.[float_cast];
            ];
        ];
    [result] := value;
];