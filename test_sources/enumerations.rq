[enumeration MyEnum, 32,
    APPLE:[signed]    = 0;
    ORANGE:[unsigned] = 2;
    GRAPE:[binary32]  = 3;
];

[entry_point
    fruit := MyEnum.APPLE(3);
    [match fruit,
        [case APPLE, apple:=[value].`[borrow], 
            apple += 1;
        ][case ORANGE, orange:=[value].`[borrow];
            orange *= 2;
        ][default
            // do nothing!
        ];
    ];
    value :=
        [inline_match fruit,
            [case APPLE, apple:=[value], 
                [out] := apple;
            ][case ORANGE, orange:=[value],
                [out] := [signed]:orange;
            ][case GRAPE, grape:=[value],
                [out] := [signed]:grape;
            ];
        ];
    [exit_code] := value;
];