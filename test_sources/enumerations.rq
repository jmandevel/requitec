[enum Fruit, fast\Int, // will use the fastest signed integer that fits all values
    APPLE; // values that are not set will start at 0
    ORANGE = 3; // explicitly set orange to use underlying_value value of 3
    GRAPE; // this will automatically be set to 4, the previous value incremented by 1.
];

[main ()Int,
    fruit := Fruit.APPLE;

    [result] <:= fruit.[underlying_value].[cast Int];
];