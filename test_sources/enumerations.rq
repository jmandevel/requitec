[import "std"];

[enumeration MyEnum, [fast_unsigned_integer 32],
    APPLE  :[fast_unsigned_integer 32]  = 0;
    ORANGE :[fast_unsigned_integer 32] = 2;
    GRAPE  :[binary32] = 3;
];

[entry
    fruit := ..MyEnum.APPLE(3);
    [match fruit,
        [with APPLE, apple:=[value].\[var][borrow], 
            apple = apple + 1;
        ][with ORANGE, orange:=[value].\[var][borrow],
            orange = orange * 2;
        ][default
            // do nothing!
        ];
    ];
    value :=
        [inline_match fruit,
            [with APPLE, apple:=[value], 
                [out] := apple;
            ][with ORANGE, orange:=[value],
                [out] := orange.[lossy_integer_cast];
            ][with GRAPE, grape:=[value],
                [out] := grape.[lossy_float_cast];
            ];
        ];

    [result] := value;
];