[enumeration MyEnum, 32,
    APPLE  :[signed]   = 0;
    ORANGE :[unsigned] = 2;
    GRAPE  :[binary32] = 3;
];

[entry
    fruit := MyEnum.APPLE(3);
    [match fruit,
        [with APPLE, apple:=[value].`[borrow], 
            apple = apple + 1;
        ][with ORANGE, :orange=[value].`[borrow],
            orange = orange * 2;
        ][default
            // do nothing!
        ];
    ];
    :value =
        [inline_match fruit,
            [with APPLE, apple:=[value], 
                [out] := apple;
            ][with ORANGE, orange:=[value],
                [out] := [signed]:orange;
            ][with GRAPE, grape:=[value],
                [out] := [signed]:grape;
            ];
        ];
    [exit_code] := value;
];