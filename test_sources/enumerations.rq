[import "std"]

[enumeration MyEnum, 32,
    APPLE  :.std.s32f  = 0;
    ORANGE :.std.u32f = 2;
    GRAPE  :.std.b32f = 3;
];
.
[entry
    fruit := .MyEnum.APPLE(3);
    [match fruit,
        [with APPLE, apple:=[value].`[borrow], 
            apple = apple + 1;
        ][with ORANGE, :orange=[value].`[borrow],
            orange = orange * 2;
        ][default
            // do nothing!
        ];
    ];
    value :=
        [inline_match fruit,
            [with APPLE, apple:=[value], 
                [out] := apple;
            ][with ORANGE, orange:=[value],
                [out] := .std.s32f:orange;
            ][with GRAPE, grape:=[value],
                [out] := .std.s32f:grape;
            ];
        ];
    [exit_code] := value;
];