[enumeration MyEnum, 32,
    APPLE:[signed]    = 0;
    ORANGE:[unsigned] = 2;
    GRAPE:[binary32]  = 3;
];

[entry_point
    fruit := MyEnum.APPLE(3);
    [match fruit,
        [case APPLE, apple:=[value].`[borrow], 
            apple += 1;
        ][case ORANGE, orange:=[value].`[borrow],
            orange *= 2;
        ][default
            // do nothing!
        ];
    ];
    value :=
        [inline_match fruit, out:=[out].`[borrow],
            [case APPLE, apple:=[in], 
                out := apple;
            ][case ORANGE, orange:=[in],
                out := [signed]:orange;
            ][case GRAPE, grape:=[in],
                out := [signed]:grape;
            ];
        ];
    [exit_code] := value;
];