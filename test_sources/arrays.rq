[import "std"];

[entry
    my_array : \[var] = [initialize_array 0, 1, 2, 3, 4].[of [least_signed_integer 64]];
    const_fat_pointer := my_array.[span];
    
    ..std.print(line=
        "stats: size:" +> my_array.[type].[byte_size] +>
        " count:" +> my_array.[type].[element_count] +>
        " depth:" +> my_array.[type].[bit_depth] +>
        "!");
    [for my_array, index:=[index], element:=[value], 
        element = element * index.[lossy_platform_cast element.[type]];
    ];
    [for my_array.[borrow], index:=[index], element:=[value], 
        ..std.print(line="element " +> index +> " is " +> element +> "!");
    ];
    ..std.print(line="it starts with " +> my_array.[at 0] +> "!");

    [result] := 0;
];