[import "std"];

[entry_point
    my_array :`= {0, 1, 2, 3, 4};
    my_span := my_array.[span];
    my_span_to_mutable := my_array.`[span];
    std.print(line="stats: size:{my_array.[byte_size]} count:{my_array.[element_count]} depth:{my_array.[bit_depth]}!");
    [for my_array, index:=[index], element:=[value].`[borrow], 
        element *= index;
    ];
    [for my_array, index:=[index], element:=[value], 
        std.print(line="element {index} is {element}!");
        index += 1;
    ];
    std.print(line="it starts with {my_array[0]}!");
];