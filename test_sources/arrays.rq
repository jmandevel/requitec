[import "std"];

[entry_point
    my_array :`= {0, 1, 2, 3, 4};
    my_view := my_array.getView();
    std.print(line="stats: size:{my_array.getByteSize()} count:{my_array.getElementCount()} depth:{my_array.getBitDepth()}!");
    [for my_array, index:=[index], element:=[value].borrow`(), 
        element *= index;
    ];
    [for my_array, index:=[index], element:=[value], 
        std.print(line="element {index} is {element}!");
        index += 1;
    ];
    std.print(line="it starts with {my_array.at(0)}!");
];