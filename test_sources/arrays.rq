[import "std", std];

mangle::main
[proc , ()SInt,
    my_array : mut\Array{5}@LSInt64 = [array 0, 1, 2, 3, 4].[of LSInt64];
    const_slice : mut\Slice@LSInt64 = my_array->std.slice();
    
    std.print(line=
        "stats: size:" +> my_array.[type].[byte_size] +>
        " count:" +> my_array.[type]->std.count() +>
        " depth:" +> my_array.[type].[bit_depth] +>
        "!");
    [for index := 0; my_array, element:=[value], 
        element = element * index.[cast element.[type]];
        index = index + 1;
    ];
    [for index := 0; my_array.[ref], element:=[value], 
        std.print(line="element " +> index +> " is " +> element +> "!");
        index = index + 1;
    ];
    std.print(line="it starts with " +> my_array.[ref]->std.at{0}() +> "!");

    result <:= 0;
];
