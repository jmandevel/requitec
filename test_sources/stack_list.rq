[import "std"];

[class MyClass, [public][layout_constructor];
    [public][constructor {> a:[signed_integer], b:[signed_integer] <},
        [result] <:= MyClass.[init a + b];
    ];
    {> [public] var:[signed_integer] }
];

[function [main], ()[signed_integer],
    // create stack
    my_stack :[var]\= std.StackList{MyClass}();
    
    // push back one element
    // emplace will call the function in the future with the given arguments forwarded
    my_stack.pushBack(MyClass(1, 2).[emplace]);

    // remove the last element
    my_stack.popBack();
    
    [result] <:= 0;
];