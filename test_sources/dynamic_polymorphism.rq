[import "std"];

[interface Speak,
    [method speak, ()[void]=>&,];
];

[implicit_drop]
[class Dog,];

[implicit_drop]
[class Cat,];

[implement_interface ..Dog, ..Speak,
    [method speak, ()[void]=>&,
        ..std.print(line="Woof!");
    ];
];

[implement_interface ..Cat, ..Speak,
    [method speak, ()[void]=>&,
        ..std.print(line="Meow!");
    ];
];

[entry
    dog := ..Dog();
    cat := ..Cat();
    dog->..Speak.speak();
    cat->..Speak.speak();
];