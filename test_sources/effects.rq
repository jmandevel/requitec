[import "std", std];

// pure and impure modifiers are applied to functions to notate if they have side effects.
// this is used to do compile time optimizations.
// also, you cannot have an impure function as an rvalue sub-expression.
// this forces you to write requite in multiple statements, storing intermediate values in variables.
// this makes control flow much more clear than other languages!

// note: functions that throw also cannot be called as an rvalue sub-expression.
// see exceptions.rq to see how this works.

// a pure function has no side effect.
// if a pure function does something with a side effect, this causes a compiler error.
// returning a value, mutating referenced arguments, mutating reciver are ok in pure functions.
pure
[function myAdd, (> a:SInt, b:SInt <)SInt, result,
    result <:= a + b;
];

// impure functions have side effects. in this case, calling print outputs text to stdout.
// impure is default, so if no modifier is applied functions automatically have impure.
// writing it explicitly here for this example.
impure
[function myPrint, (> val:SInt)SInt,
    std.print(line="Hello, world!");
];

// global predefined variables need to have initial value with no side effects.
// note that global variables are predefined by default. 
// predefined is specified here explicitly for this example.
runtime predefined MY_NUMBER := myAdd(1, 2);

[main ()SInt, result,
    // pure functions can be rvalue sub-expressions
    added := myAdd(1, myAdd(2, 3));

    // impure functions cannot be rvalue sub-expressions
    printed := myPrint(3);

    // if this is uncommented, its a compiler error
    // added_printed := myAdd(myPrint(0), myPrint(1));
    // write like this instead:

    a := myPrint(0);
    b := myPrint(1);
    added_printed := myAdd(a, b);

    result <:= 0;
];