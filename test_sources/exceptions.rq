[import "std", std];

pure
[function divide, 
    throw::(Slice@Utf8, SInt)\
    ( numerator:SInt, denominator:SInt <)SInt, result,
    [if denominator==0,
        "The denominator cannot be 0".[throw];
    ];
    [if numerator==0,
        15.[throw];
    ];
    result <:= numerator / denominator;
];

[proc , ()SInt, result,
    [try
        intermediate := divide(10, 2).[pass 0];
        result <:= divide(5, 0).[pass 1];
    ][catch (0, 1), message:Slice@Utf8,
        std.print(line=message);
        result <:= 0;
    ][catch (0, 1), number:SInt,
        result <:= number;
    ];
];