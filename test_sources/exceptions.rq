[import "std", std];

pure
[function divide, 
    throw::(Slice@Utf8,SInt)\
    ( numerator:SInt, denominator:SInt <)SInt, result,
    [if denominator==0,
        "The denominator cannot be 0".[throw];
    ];
    [if numerator==0,
        15.[throw];
    ];
    result <:= numerator / denominator;
];

[main ()SInt, result,
    [try
        result <:= divide(5, 0).[pass Slice@Utf8, SInt];
    ][catch message:Slice@Utf8,
        std.print(line=message);
        result <:= 0;
    ][catch number:SInt,
        result <:= number;
    ];
];