[import "std"];

[template]::{> InterpolatedString:[type] <}
[function interpolatedFunc, (> string:InterpolatedString <)[void],
    [spin string,
        [weave str:[string]=[value],
            ..std.print(line="found string: " +> substr);
        ][weave int:[integer]=[value],
            ..std.print(line="found integer: " +> int);    
        ][weave float:[float]=[value],
            ..std.print(line="found float: +> float);
        ][weave any:=[value],
            ..std.print(line="found something else: " +> any.[borrow]);
        ];
    ];
];

[entry
    ..interpolatedFunc(
        "this has a float " +>
        3.14.[as [single]] +>
        " an int " +>
        0.[as[fast_signed_integer 32]] +>
        " and a boolean " +>
        [true] +>
        ".");

    [result] := 0;
];