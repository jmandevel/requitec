[class Partialable,
    {>
        public partial_mutate property_a : FSInt32 = 0,
        public property_b : FSInt32 = 0
    <},

     public pure[layout_constructor];
];

// comtime variables must have variables of no_mut type becauese
// they are constant:
comtime never_mut : no_mut\ = Partialable();

mangle::main
[proc , ()SInt, result,
    // all properties are mut for fully mut values:
    fully_mut : mut\ = Partialiable();

    // only properties marked with [partial_mut] are mut for partially mut values:
    partially_mut : partial_mut\ = Partialable();

    result <:= 0;
];