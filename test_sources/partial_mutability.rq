[class Partialable,
    {>
        public partial_mutate property_a : fast\Int32 = 0,
        public property_b : fast\Int32 = 0
    <},

     public[layout_constructor];
];

[main ()Int,
    // compile_time variables must have variables of no_var type becauese
    // they are constant:
    compile_time never_var : no_var\ = Partialable();

    // all properties are var for fully var values:
    fully_var : var\ = Partialiable();

    // only properties marked with [partial_var] are var for partially var values:
    partially_var : partial_var\ = Partialable();

    result <:= 0;
];