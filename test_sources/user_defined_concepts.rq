// this concept only passes for float types of SInt32
// Subject is the name of the symbol we are going to test.
concept FLOAT_OR_SINT32 =Subject\\ Subject.[is FLOAT] || Subject.[is SInt32];

// this template has constraints on the parameter, only accepting types that match the concept
pure template::{ auto Type:FLOAT_OR_SINT32 <}
[procedure addOne, ( num:Type <)Type, result,
    result <:= num + 1;
];

mangle::main
[procedure , ()SInt, result,
    float := addOne(3.14);
    result <:= addOne(0);
];

concept TYPE_TUPLE =Subject\\ [validate result,
        // bang operator in front of concept uses logical complement
        // !TUPLE is like saying symbol must not be a tuple
        [if Subject.[is !TUPLE], 
            result <:= false;
            done;
        ];
        [for Subject.[parameter_range], param:=value.[ref],
            [if param.[type].[is !TYPE],
                result <:= false;
                done;
            ];
        ];
        result <:= true;
    ];

// this is an opaque function. it exists nowhere, but we can still perform substitution checking against it.
// however, actually calling it is a bad idea because it will cause a linking error.
opaque mangle:myFunc
[procedure myFunc, ( in:SInt <)Void ];

// with [check_frame] you can perform substitution checking as if in procedure frame scope
concept MY_FUNC_ARG :Subject= [check_frame val:Subject, 
        myFunc(val);
    ];

