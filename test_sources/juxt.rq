[import "std", std];

template::{> auto List:ANY <}
[procedure printList, (> list:List <)Void,
    std.print(line="begin!");
    pre [for list, item:=value.[ref],
        [fold text:Slice@Utf8,
            pre [if item.[is INT],
                text <:= "found integer: ";
            ] pre [else_if item.[is FLOAT],
                text <:= "found float: ";
            ][else
                text <:= "found something else: ";
            ];
        ];
        std.print(line=text +> item);
    ];
    std.print(line="end!");
];

[main ()SInt, result,
    printList(
        "hello" +>
        3.14.[as Single] +>
        0.[as FSInt32] +>
        true);

    printList(
        "this" $
        "is" $
        "one" $
        "string" $
        "literal");

    result <:= 0;
];