[import "std", std];

template::{> auto List:ANY <}
[proc printList, (> list:List <)Void,
    std.print(line="begin!");
    pre [for list.[juxt_range], item:Generic@TYPE=value.[ref],
        text:Slice@Utf8=;
        inits::text
        pre [if item.[is INT],
            text ?= "found integer: ";
        ] pre [else_if item.[is FLOAT],
            text ?= "found float: ";
        ] pre [else
            text ?= "found something else: ";
        ];
        std.print(line=text +> item);
    ];
    std.print(line="end!");
];

mangle::main
[proc , ()SInt,
    printList(
        "hello" +>
        3.14.[as Single] +>
        0.[as FSInt32] +>
        true);

    result <:= 0;
];

# juxt are the same as trip but are written differently.
# sett trip.rq