
// the layout of this prototype is unknown. it can be defined later if the class is fully implemented.
opaque mangle::MyClass
[class MyClass, Unknown];

opaque mangle::getInstanceRef
[proc getInstance, ()Ref@MyClass];

// when this class fully implemented, it can be a maximum of 64 bits in size
opaque mangle::SizedClass
[class SizedClass, margin::64\Unknown,

    opaque
    [proc doSomething, ()Void=>Ref@mut\];
];

opaque mangle::getSized
[proc getSized, ()MyClass];

[main ()SInt, result,
    ref := getInstanceRef().[borrow];
    sized := getSized(); 
    // Sized uses 64 bits of memory in the stack.
    // However, the class layout is unknown.
    // Its not possible to access members directly.
    sized.mut\[borrow].doSomething();
    result <:= ref.[address].[cast];
];