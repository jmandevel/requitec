# templates refeer to declarations with template modifiers

template::{> NUM:SInt <}
pure
[proc getNum, ()SInt,
    result <:= NUM;
];

# templates have different overloads attached to them, one for each specialization

# declarations without a template modifier are attached directly to polymorph

pure
[proc getNum, ()SInt,
    result <:= 0;
];

pure
[proc getNum, (> num:SInt <)SInt,
    result <:= num;
];

# get overload with no args.
comtime noArgs := getNum.[resolve_proc ()SInt];

# get specialization with signature and given template args
comtime templateNoArgs := getNum{ NUM=0 }.[resolve_proc ()SInt];

# loop over all templates of polymorphs found through alias
[for getNum.[template_range], template := value,
    # etc
];

# loop over all overloads of all polymorphs of alias
[for getNum.[overload_range], overload := value,
    # etc
];