[import "std"];

[enum Fruit, fast\unsigned\Int32,
	anchor::A
	static [for 0.<100, num:=[value],
		static name := std.format(text= "MY_FRUIT" +> num);
		flank::A name.getSlice().[identify];
	];
];

[main ()Int,
	my_fruit := Fruit.MY_FRUIT42;
	
	[result] <:= my_fruit.[underlying_value].[cast Int32];
];

