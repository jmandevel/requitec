[import "std", std];

template::{> Type:FLOAT <}
weight::1
[proc printType, ( val:Type <)Void,
    std.print(line="Its a float");
];

template::{> Type:INT <}
weight::1
[proc printType, ( val:Type <)Void,
    std.print(line="Its an integer");
];

template::{> Type:TYPE <}
[proc printType, ( val:Type <)Void,
    std.print(line="Its something");
];

mangle::main
[proc , ()SInt, result,
    printType{SInt32}();
    printType{Single}();
    printType{Bool}();

    result <:= 0;
];