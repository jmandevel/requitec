[import "std", std];

[procedure printMe, 
    (|
        snippet:=callsite.[snippet],
        line:=callsite.[line],
        column:=callsite.[column]
    )Void,
    std.print(line=
        "snippet: \"" +> snippet +> "\"" +>
        " line: " +> line +>
        " column: " +> column);
];

[main ()SInt, result,
    // this will print the following line to the terminal:
    // snippet: "printMe()" line: 18 column: 4
    printMe();
    result <:= 0;
];

// callsite is only usable for default parameter/property values