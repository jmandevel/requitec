[variant Number, SInt, 
    integer : SInt32;
    float : Binary32;
    double : Binary64;
    quad : Binary128;
];

[import "std", std];

mangle::main
[proc , () result:SInt,
    num0 := Number.integer(4);
    num1 := Number.float(3.14);
    num2 := Number.double(2.18);

    str:Slice@Utf=;

    inits::str.[reflect]
    [match num0
        ][arm Number.integer, v:, out:=v,
            str ?= "its an integer";
        ][arm Number.float, v:, out:=v,
            str ?= "its a float";
        ][arm Number.double, v:, out:=v,
            str ?= "its a double";
        ][else
            str ?= "its something else";
        ];

    std.print(line=str);

    result <:= 0;
];
