[import "std", std];

[main (>args:Ptr@Ptr@Char<)SInt, result,
    [if args.[element_count] == 0,
        result <:= 5;
    ][else 
        result <:= 6;
    ];
];

[proc doMath, (>int:SInt<)SInt, result,

    other_int :mut\= 2; // `<:` is upbiniding (variable exists in higher scope), and `:` is normal binding (variable exists in current scope).

    other_int = 3; // to reassign to existing variable dont add the binding.

    // folded variables must be initialized exactly once in each control flow path of fold or function must return before fold is done.
    // for functions that return, [result] must have upbinding exactly once for each control flow path.

    // binding to variable more than once in any control flow path (upbinding or otherwise) is compiler error.
    // upbinding to variable in loops is not allowed because this counts as multiple paths.
    // (maybe can allow variables without destructors to be upbound in loops somehow...)

    [fold mut:SInt,
        [if int < 7,
            mut <:= 7;
        ][else_if int > 9,
            [result] <:= 0; // result must be set before return
            return; // dont need to set mut because function returns before the fold ends
        ][else
            mut <:= 1;
        ];
    ];
    result <:= mut; // result was set in [else_if] condition which never reaches here, so its ok to initialize it again.
];