[import "std", std];

mangle::main
[proc , ()SInt, 
    list := std.List{SInt}();
    [for 
        SInt index := 0; // this is created before first loop iteration and exists for all iterations.
        list.pushBackSpan(5),
        uninit:=value.unset\mut\[ref],
        uninit ?= index * 2;
    ][amid // this occurs every loop continue
        index = index + 1;
    ];
    result <:= 0;
];