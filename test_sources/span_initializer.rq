[import "std", std];

mangle::main
[proc , ()SInt, 
    list := std.List{SInt}();
    [for 
        SInt index := 0; // this is created before first loop iteration and exists for all iterations.

        list.pushBackSpan(5).[take],
        uninit:=value.unset\mut\[ref],

        uninit ?= index * 2;
        index = index + 1;
    ];

    other_list := std.List{SInt}();

    // move items over manually
    [for
        span:=other_list.pushBackSpan(list.count());
        span.[take]->std.reverse(),
        uninit:=value.unset\mut\[ref],

        uninit ?= list.popBack();
    ];  
    result <:= 0;
];