

opaque mangle::malloc
[proc malloc, (size:USize<)Ptr@mut\Void];

opaque mangle::free
[proc free, (ptr:Ptr@mut\Void<)Void];

template::{ Type:TYPE <}
[class UniquePtr,
    { ptr:Ptr@mut\Type <},

    public[layout_constructor];

    public inline
    template::{Placement:PLACEMENT<}
    [proc create, 
        (placement:Placement<)mut\UniquePtr{Type},

        ptr := malloc(Type.[byte_size]).[cast Ptr@mut\Type];
        result <:= UniquePtr{Type}(
                ptr=ptr
            );   
        this.ptr.[inplace_init placement.[invoke]];
    ];

    public[destructor         
        this.ptr.[content].[inplace_destroy];
        free(this.ptr);
        this.[forget];
    ];

];

[class MyClass,
    { val:Single <},

    public[layout_constructor];
];

mangle::main
[proc , ()SInt,
    uptr := UniquePtr{MyClass}.create(
            MyClass(3.14).[emplace]
        );
    result <:= 0;
];