

[opaque][explicit_mangle]::malloc
[function 
    [no_name], // has no name so must use mangled name from c table
    (size:[unsigned_address]<)?\[var][void],
];

[opaque][explicit_mangle]::free
[function [no_name], (ptr:?\var[void]<)[void],];

[template]::{Type:[symbol]<}
[constrain]::(Type.[is_type])
[class UniquePtr,
    { [private] ptr:?\[var]Type <},

    [public][inline]
    [template]::{Placement:[symbol]<}
    [constrain]::Placement.[is_placement_type Type]
    [function create, 
        (placement:Placement<)\[var]UniquePtr{Type},

        ptr := [c].malloc(Type.[byte_size]).[cast ?\[var]Type];
        [result] := UniquePtr{Type}(
                ptr=ptr
            );   
        [this].ptr.[inplace_initialize placement.[invoke]];
    ];

    [destructor         
        [this].ptr.[content].[inplace_destroy];
        [c].free([this].ptr);
        [this].[drop];
    ];

];

[stable_address]
[class MyClass,
    { val:[single] <}

    [destructor
        [this].[drop];
    ];
];

[entry
    uptr := ..UniquePtr{..NoAutoDrop}.create(
            ..MyClass(3.14).[emplace]
        );
    [result] := 0;
];