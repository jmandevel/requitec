

[opaque][mangle]::malloc
[function malloc, (size:[unsigned_address]<)?[var]\[void]];

[opaque][mangle]::free
[function free, (ptr:?[var]\[void]<)[void]];

[template]::{Type:[symbol]<}
[constraint]::(Type.[is_type])
[class UniquePtr,
    { ptr:?[var]\Type <},

    [public][inline]
    [template]::{Placement:[symbol]<}
    [constraint]::Placement.[is_placement_type Type]
    [function create, 
        (placement:Placement<)[var]\UniquePtr{Type},

        ptr := malloc(Type.[byte_size]).[cast ?[var]\Type];
        [result] := UniquePtr{Type}(
                ptr=ptr
            );   
        [this].ptr.[inplace_initialize placement.[invoke]];
    ];

    [function [destroy], ()[void]=>,         
        [this].ptr.[content].[inplace_destroy];
        free([this].ptr);
        [this].[drop];
    ];

];

[no_stable_address]
[class MyClass,
    { val:[single] <},

    [function [destroy], ()[void]=>,
        [this].[drop];
    ];
];

[function [main], ()[signed_integer],
    uptr := UniquePtr{NoAutoDrop}.create(
            MyClass(3.14).[emplace]
        );
    [result] <:= 0;
];