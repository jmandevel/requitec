[import "std"];

@may_copy @may_move
[object MyObject,
    {>
        x := 0,
        y := 0,
        z := 0
    <},

    @public
    [constructor];

    @public
    [constructor (>x:[signed], y:[signed], z:[signed]<),
        {x=x, y=y, z=z},
    ];

    @public
    [method getTotal, &=>(><)[signed],
        [result] := [this].x + [this].y + [this].z;
    ];

    @public
    [function add, (>a:MyObject, b:MyObject<)MyObject,
        [result] :=
            MyObject(
                a.x + b.x,
                a.y + b.y,
                a.z + b.z
            );
    ];
];

[entry_point

    a := MyObject();
    b := MyObject(1, 2, 3);

    std.print(line="a total:{a.[borrow].getTotal()}");

    added := MyObject.add(a, b);

    [exit_code] := added.[borrow].getTotal();
];