[import "std", std];

[class MyClass,
    {>
        public x : fast\Int32 = 0,
        public y : fast\Int32 = 0,
        public z : fast\Int32 = 0
    <},

    public [layout_constructor];

    public
    [function fromScalar, (> scalar:fast\Int32 <)MyClass,
        [result] <:= MyClass(scalar, scalar, scalar);    
    ];

    public
    [function getTotal, ()fast\Int21=>$,
        [result] <:= this.x + this.y + this.z;
    ];

    public
    [function add, (>a:MyClass, b:MyClass<)MyClass,
        [result] <:=
            MyClass(
                a.x + b.x,
                a.y + b.y,
                a.z + b.z
            );
    ];
];

[main ()Int,

    a := MyClass();
    b := MyClass(1, 2, 3);
    c := MyClass.fromScalar(4);

    std.print(line="a total:{a.[borrow].getTotal()}");

    added := MyClass.add(b, c);

    [result] := added.[borrow].getTotal();
];