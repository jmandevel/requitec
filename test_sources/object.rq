[import "std", std];

[class MyClass,
    {>
        public x : FSInt32 = 0,
        public y : FSInt32 = 0,
        public z : FSInt32 = 0
    <},

    public pure [layout_constructor];

    public pure
    [procedure fromScalar, (> scalar:FSInt32 <)MyClass, result,
        result <:= MyClass(scalar, scalar, scalar);    
    ];

    public pure
    [procedure getTotal, ()FSInt32=>Ref@, result,
        result <:= this.x + this.y + this.z;
    ];

    public pure
    [procedure add, (>a:MyClass, b:MyClass<)MyClass, result,
        result <:=
            MyClass(
                a.x + b.x,
                a.y + b.y,
                a.z + b.z
            );
    ];
];

mangle::main
[procedure , ()SInt, result,

    a := MyClass();
    b := MyClass(1, 2, 3);
    c := MyClass.fromScalar(4);

    std.print(line="a total:{a.[ref].getTotal()}");

    added := MyClass.add(b, c);

    result <:= added.[ref].getTotal();
];