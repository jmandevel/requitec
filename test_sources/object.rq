[import "std"];

[class MyClass,
    {>
        [public] x : [fast_signed_integer 32] = 0,
        [public] y : [fast_signed_integer 32] = 0,
        [public] z : [fast_signed_integer 32] = 0
    <},

    [public]
    [function fromScalar, (> scalar:[fast_signed_integer 32] <)MyClass,
        [result] := MyClass(scalar, scalar, scalar);    
    ];

    [public]
    [function getTotal, ()[fast_signed_integer 32]=>$,
        [result] := [this].x + [this].y + [this].z;
    ];

    [public]
    [function add, (>a:MyClass, b:MyClass<)MyClass,
        [result] :=
            MyClass(
                a.x + b.x,
                a.y + b.y,
                a.z + b.z
            );
    ];
];

[function [main], ()[signed_integer],

    a := MyClass();
    b := MyClass(1, 2, 3);
    c := MyClass.fromScalar(4);

    std.print(line="a total:{a.[borrow].getTotal()}");

    added := MyClass.add(b, c);

    [result] := added.[borrow].getTotal();
];