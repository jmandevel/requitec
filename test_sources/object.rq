[import "std"];

[object MyObject,
    {>
        @private x := 0,
        @private y := 0,
        @private z := 0
    <},

    #std.useExtensions();

    [constructor];

    [constructor (>x:[signed], y:[signed], z:[signed]<),
        {x=x, y=y, z=z},
    ];

    [method getTotal, (><)[signed],
        [result] := [this].x + [this].y + [this].z;
    ];

    [function add, (>a:MyObject, b:MyObject<)MyObject,
        [result] :=
            MyObject(
                a.x + b.x,
                a.y + b.y,
                a.z + b.z
            );
    ];
];

[entry_point

    a := MyObject();
    b := MyObject(1, 2, 3);

    std.print(line=std."a total:{a.getTotal()}");

    added := MyObject.add(a, b);

    [result] := added.getTotal();
];