[import "std"];

@may_copy @may_move
[class MyClass,
    {>
        x := 0sl32,
        y := 0sl32,
        z := 0sl32
    <},

    @public
    [constructor];

    @public
    [layout_constructor];

    @public
    [constructor (>scalar:[signed].[least_bits 32]<),
        { x=scalar, y=scalar, z=scalar},
    ];

    @public
    [method getTotal, &=>(><)[signed].[least_bits 32],
        [result] := [this].x + [this].y + [this].z;
    ];

    @public
    [function add, (>a:MyClass, b:MyClass<)MyClass,
        [result] :=
            MyClass(
                a.x + b.x,
                a.y + b.y,
                a.z + b.z
            );
    ];
];

[entry

    a := .MyClass();
    b := .MyClass(1, 2, 3);

    .std.print(line="a total:{a.[borrow].getTotal()}");

    added := .MyClass.add(a, b);

    [exit_code] := added.[borrow].getTotal();
];