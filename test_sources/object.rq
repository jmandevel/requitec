[import "std", std];

[class MyClass,
    {>
        public x : FSInt32 = 0,
        public y : FSInt32 = 0,
        public z : FSInt32 = 0
    <},

    public [layout_constructor];

    public
    [function fromScalar, (> scalar:FSInt32 <)MyClass, result,
        result <:= MyClass(scalar, scalar, scalar);    
    ];

    public
    [function getTotal, ()FSInt32=>Ref@, result,
        result <:= this.x + this.y + this.z;
    ];

    public
    [function add, (>a:MyClass, b:MyClass<)MyClass, result,
        result <:=
            MyClass(
                a.x + b.x,
                a.y + b.y,
                a.z + b.z
            );
    ];
];

[main ()SInt,

    a := MyClass();
    b := MyClass(1, 2, 3);
    c := MyClass.fromScalar(4);

    std.print(line="a total:{a.[borrow].getTotal()}");

    added := MyClass.add(b, c);

    added.[borrow].getTotal().[return];
];