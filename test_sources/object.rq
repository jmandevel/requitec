[object MyObject,
    {>
        @private x := 0,
        @private y := 0,
        @private z := 0,
    <},

    [constructor]

    [constructor (>x:[signed], y:[signed], z:[signed]<),
        {x=x, y=y, z=z}
    ]

    [function getTotal, ->(><)[signed],
        [result] = .x + .y + .z;
    ]

    [function add, (>a::MyObject, b::MyObject<)MyObject,
        [result] =
            MyObject(
                a.x + b.x,
                a.y + b.y,
                a.z + b.z
            );
    ]
]

[import "std"]

[entry_point

    a := MyObject();
    b := MyObject(1, 2, 3);

    std.print(line="a total:{a.getTotal()}");

    added := MyObject.add(a, b);

    [exit added.getTotal()];
]