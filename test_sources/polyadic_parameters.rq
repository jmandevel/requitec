// note: this is not currently an implementation target.

// note: polyadic parameters can never be named.

// note:parameter marks must be placed appropriatly.

// note: there can only ever be one polyadic parameter in a signature or layout.

// note: if a signature or layout has a polyadic parameter, it must be the 
// last postional parameter.

[procedure getSum, ( ...var:SInt <)SInt, result,
    result <:= 0;
    pre [for var, num:=value,
        result = result + num;
    ];
];

[import "std", std];

template::{ ...Types:std.Type <}
[procedure printAll, ( ...values:Types <)Void,
    // note: must be pre so loop gets unrolled because types could be different.
    pre [for values, value:=value.[ref], 
        std.print(line=value);    
    ];
];

template::{ ...Types:std.Type <}
[procedure printThird, ( ...values::Types <)Void,
    pre [if values.[element_count] < 3,
        std.print(line="There are less than three!");
    ][else
        // third element is at 0 two because polyadic argments are 0 indexed.
        std.print(line=values.[at 2]);
    ];
];