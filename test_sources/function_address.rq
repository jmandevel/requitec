[proc myFunction, ( 
        positional:Single=0.0,
        >positional_and_named:Single=0.0<,
        named:Single=0.0,
        |locked:Single=0.0
    )Single, result,
    result <:= 
    (positional + positional_and_named + named + locked);
];

[proc myOtherFunction, ( 
        positional:Single=0.0,
        >positional_and_named:Single=0.0<,
        named:Single=0.0,
        |locked:Single=0.0
    )Single, result,
    result <:= (positional + positional_and_named + named + locked);
];

[proc myThirdFunction, ( 
        positional:Single=0.0,
        >positional_and_named:Single=0.0<,
        named:Single=0.0 * 0.0,
        |locked:Single=0.0
    )Single, result,
    result <:= (positional + positional_and_named + named + locked);
];

[proc myFourthFunction, ( 
        first_arg:single=0.0,
        >positional_and_named:single=0.0<,
        named:single=0.0,
        |locked:single=0.0
    )Single, result,
    result <:= (positional + positional_and_named + named + locked);
];


[main ()SInt, result,
    // calling directly from myFunction
    // default values are used
    // locked parameters cannot be set
    // parameter marks apply
    a := myFunction();
    b := myFunction(1.0);
    b := myFunction(1.0, 2.0);
    c := myFunction(1.0, positional_and_named);
    d := myFunction(1.0, named=2.0);
    e := myFunction(1.0, named=2.0, positional_and_named=3.0);
    f := myFunction(1.0, 2.0, named=3.0);
    g := myFunction(1.0, positional_and_named=2.0, named=3.0);

    // call from a pointer to myFunction
    ptr :\mut= myFunction.[proc_address];
    // you can call from ptr just like myFunction
    h := ptr(1.0, 2.0, named=3.0, locked=4.0);
    i := ptr();
    j := ptr(1.0);
    k := ptr(1.0, 2.0);
    l := ptr(1.0, positional_and_named);
    m := ptr(1.0, named=2.0);
    n := ptr(1.0, named=2.0, positional_and_named=3.0);
    o := ptr(1.0, 2.0, named=3.0);
    p := ptr(1.0, positional_and_named=2.0, named=3.0);

    // can assign different function to variable if its [mut] and has EXACTLY the same signature.
    // the default values need to have identical expressions when situated.
    ptr = myOtherFunction.[proc_address];
    ptr();

    // type is different even if default value evaluates to the same result.
    // ptr = myThirdFunction.[proc_address]; 
    // this would result in compile error because named parameter's default value is wrong.
    // its wrong even though it still evaluates to 0.
    // need to use sig_cast
    ptr = myThirdFunction.[proc_address].[sig_cast];
    ptr();
    
    // need to cast if parameters are named differently
    ptr = myFourthFunction.[proc_address].[sig_cast];
    ptr();

    result <:= 0;
];