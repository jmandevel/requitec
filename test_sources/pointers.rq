[entry
    // if you know C, this should be super easy to understand.

    // mutable single floating point number
    var :`[mutable][single]= 0;

    // mutable pointer to mutable single float (? is pointer)
    var_ptr :`[mutable]?`[mutable][single]= var.`[mutable][address];

    var_ptr.[content] = 1;

    var_copy := var_ptr.[content];

    var_ptr = [null];

    [result] := var_copy.[float_cast];
];