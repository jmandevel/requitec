[entry
    // var single floating point number
    var :\[var][single]= 0;

    // var pointer to var single float (? is pointer)
    var_ptr :\[var]?\[var][single]= var.\[var][address];

    var_ptr.[unsafe_content] = 1;

    var_copy := var_ptr.[unsafe_content];

    var_ptr = [null];

    [result] := var_copy.[lossy_float_cast];
];