[import "std", std];

[class WithoutDestroy, public pure[layout_constructor]; {}];

[class WithDestroy, public[layout_constructor]; {},
    [destructor
        std.print(line="In destroy!");
        this.[take].[ignore];
    ];
];

mangle::main
[proc , ()SInt,
    a := WithoutDestroy();
    b := WithoutDestroy();
    c := WithDestroy();
    d := WithDestroy();

    // after ignore or destroy, variable is invalidated (can no longer be used)
    a.[take].[ignore]; 

    // since b's type has no destroy, behaviour is same as b.[take].[ignore]
    b.[take].[destroy];

    // even though c's type has a destroy, its not called
    c.[take].[ignore];

    // d's destroy is called
    d.[take].[destroy];

    without := WithoutDestroy();
    with := WithDestroy();

    // if type has no destroy, can do a shallow copy (copies byte for byte)
    copy := without; 

    // this results in a compile error if uncommented because cannot shallow copy types with destroys 
    // other_copy := with;

    result <:= 0;
];

