[import "std"];

[class WithoutDestroy];

[class WithDestroy,
    [function [destroy], ()[void]=>,
        std.print(line="In destroy!");
        [this].[drop];
    ];
];

[main
    a := WithoutDestroy();
    b := WithoutDestroy();
    c := WithDestroy();
    d := WithDestroy();

    // after drop or destroy, variable is invalidated (can no longer be used)
    a.[drop]; 

    // since b's type has no destroy, behaviour is same as b.[drop]
    b.[take].[destroy];

    // even though c's type has a destroy, its not called
    c.[drop];

    // d's destroy is called
    d.[take].[destroy];

    without := WithoutDestroy();
    with := WithDestroy();

    // if type has no destroy, can do a shallow copy (copies byte for byte)
    copy := without; 

    // this results in a compile error if uncommented because cannot shallow copy types with destroys 
    // other_copy := with;

    [result] := 0;
];

