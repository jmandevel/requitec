[import "std"];

[interface ISpeak,
    [function speak, ()[void]=>,
        std.print(line="I don't speak.");
    ];
];

[class Dog];

[class Cat];

[class Rat,
    [function squeak, ()[void]=>,
        std.print(line="Squeak!");  
    ];
];

[adapter ASpeak, ISpeak=>Dog,
    [function speak, ()[void]=>,
        std.print(line="Woof!");
    ];
];

[adapter ASpeak, ISpeak=>Cat,
    [function speak, ()[void]=>,
        std.print(line="Meow!");
    ];
];

[adapter ASpeak, ISpeak=>Rat,
    [use_method speak, Rat.squeak, ()[void]=>$];
];

[interface IGreet,
    [function greet, ()[void]=>,
        std.print(line="I don't greet.");
    ];
];

[adapter AGreet, IGreet=>Dog,
    [function greet, ()[void]=>,
        std.print(line="*wags tail*");
    ];
];

[adapter ASpeak, ISpeak=>Rat,
    [use_method speak, rat.squeak, ()[void]=>];
];

[adapter AGreet, IGreet=>Rat,
    [use_method greet, Rat.squeak, ()[void]=>];
];

[main
    dog := Dog();
    cat := Cat();
    rat := Rat();

    dog.[adapt ASpeak].speak();
    dog.[adapt AGreet].greet();
    cat.[adapt ASpeak].speak();
    cat.[adapt AGreet].greet();

    speakAndGreet(animal=dog.[compose ASpeak, AGreet]);
    speakAndGreet(animal=cat.[compose ASpeak, AGreet]);
    speakAndGreet(animal=rat.[compose ASpeak, AGreet]);

    [result] := 0;
];

[function speakAndGreet, (> animal:[composition ISpeak, IGreet] <)[void],
    animal.[decompose ISpeak].speak();
    animal.[decompose IGreet].greet();
];