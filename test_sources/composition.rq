[import "std"];

[interface Speak,
    [method speak, ()[void]=>$,];
];

[implicit_drop]
[class Dog,];

[implicit_drop]
[class Cat,];

[implicit_drop]
[class Rat,
    [function sqeak, ()[void]=>$,
        ..std.print(line="Squeak!");  
    ];
];

[implement_interface ..Dog, ..Speak,
    [method speak, ()[void]=>$,
        ..std.print(line="Woof!");
    ];
];

[implement_interface ..Cat, ..Speak,
    [method speak, ()[void]=>$,
        ..std.print(line="Meow!");
    ];
];

[implement_interface ..Rat, ..Speak,
    [use_method speak, ..Rat.squeak, ()[void]=>$];
];

[interface Greet,
    [method greet, ()[void]=$,];
];

[implement_interface ..Dog, ..Greet,
    [method greet, ()[void]=>$,
        ..std.print(line="*wags tail*");
    ];
];

[implement_interface ..Rat, ..Speak,
    [use_method speak, ..rat.squeak, ()[void]=>$];
];

[implement_interface ..Rat, ..Greet,
    [use_method greet, ..Rat.speak, ()[void]=>%];
];

[function speakAndGreet, (> animal:$[virtual_table ..Speak, ..Greet] <)[void],
    animal.[borrow]->..Speak.speak();
    animal.[borrow]->..Greet.greet();
];

[entry
    dog := ..Dog();
    cat := ..Cat();
    rat := ..Rat();

    dog.[borrow]->..Speak.speak();
    dog.[borrow]->..Greet.greet();
    cat.[borrow]->..Speak.speek();
    cat.[borrow]->..Greet.greet();

    ..speakAndGreet(animal=dog.[borrow_virtual_table ..Speak, ..Greet]);
    ..speakAndGreet(animal=cat.[borrow_virtual_table ..Speak, ..Greet]);
    ..speakAndGreet(animal=rat.[borrow_virtual_table ..Speak, ..Greet]);
];