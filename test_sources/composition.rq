[import "std", std];

[interface ISpeak,
    // this procedure is virtual so can be overriden by adapters
    // its not opaque, so it does not have to be overriden
    public virtual
    [procedure speak, ()Void=>,
        std.print(line="I don't speak.");
    ];

    // this procedure is not virtual so it cannot be overriden by adapters
    public
    [procedure doSomething, ()Void=>,
        std.print(line="do something now!");
    ];

];

[class Dog, public[layout_constructor]; {},];

[class Cat, public[layout_constructor]; {},];

[class Rat, public[layout_constructor]; {},
    public
    [procedure squeak, ()Void=>,
        std.print(line="Squeak!");  
    ];
];

[adapter A, Dog==>ISpeak,
    [public]
    [procedure speak, ()Void=>,
        std.print(line="Woof!");
    ];
];

[adapter A, Cat==>ISpeak,
    public
    [procedure speak, ()Void=>,
        std.print(line="Meow!");
    ];
];

[adapter A, Rat==>ISpeak,
    [use speak, Rat.squeak.[resolve_function ()Void=>Ref@]];
];

[interface IGreet,
    // virtual and opqaque, so there is no default implementation and adapters must implement it.
    public virtual opaque
    [procedure greet, ()Void=>];
];

[adapter A, Dog==>IGreet,
    public
    [procedure greet, ()Void=>,
        std.print(line="*wags tail*");
    ];
];

[adapter B, Dog==>IGreet,
    public
    [procedure greet, ()Void=>,
        std.print(line="bark!");
    ];
];

[main ()SInt, result,
    dog := Dog();
    cat := Cat();
    rat := Rat();

    // use adapt to get adaption between value, an interface, and an adapter
    // this is aware of reciever type, adapter, and interface at compile time
    // does not have to do virtual function lookup
    speak_adaption :mut\[adaption Dog, A-->ISpeak]= dog.[adapt A-->ISpeak].[ref];
    speak_adaption.speak();

    // use compose to create composition of 1 or more interfaces
    // this allows for dynamic polymorphism
    // with one specified, it becomes the interface composed
    dog_interface :IGreet= dog.[compose IGreet];
    dog_interface.greet();
    // with more than one specified, it becomes a composition
    dog_composition :[composition IGreet, ISpeak]= dog.[compose greet=A-->IGreet, speak=A-->ISpeak].[ref];
    // decompose a composition to get one of its interfaces
    dog_greet_adapter :IGreet= dog_composition.[decompose IGreet].[ref];
    dog_greet_adapter.greet();

    speakAndGreet(animal=dog.[compose A-->ISpeak, A-->IGreet]);
    speakAndGreet(animal=cat.[compose A-->ISpeak, A-->IGreet]);
    speakAndGreet(animal=rat.[compose A-->ISpeak, A-->IGreet]);

    result <:= 0;
];

[procedure speakAndGreet, (> animal:margin::64\[composition ISpeak, IGreet] <)Void,
    animal.[decompose ISpeak].speak();
    animal.[decompose IGreet].greet();
];