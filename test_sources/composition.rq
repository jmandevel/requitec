[import "std"];

[interface ISpeak,
    // this function is virtual so can be overriden by adapters
    // its not opaque, so it does not have to be overriden
    [public][virtual]
    [function speak, ()[void]=>,
        std.print(line="I don't speak.");
    ];

    // this function is not virtual so it cannot be overriden by adapters
    [public]
    [function doSomething, ()[void]=>,
        std.print(line="do something now!");
    ];

];

[class Dog, [public][layout_constructor]; {},];

[class Cat, [public][layout_constructor]; {},];

[class Rat, [public][layout_constructor]; {},
    [public]
    [function squeak, ()[void]=>,
        std.print(line="Squeak!");  
    ];
];

[adapter A, ISpeak..Dog,
    [public]
    [function speak, ()[void]=>,
        std.print(line="Woof!");
    ];
];

[adapter A, ISpeak..Cat,
    [public]
    [function speak, ()[void]=>,
        std.print(line="Meow!");
    ];
];

[adapter A, ISpeak..Rat,
    [use speak, Rat.squeak.[plain_genre].[overload ()[void]=>$]];
];

[interface IGreet,
    // virtual and opqaque, so there is no default implementation and adapters must implement it.
    [public][virtual][opaque]
    [function greet, ()[void]=>];
];

[adapter A, IGreet..Dog,
    [public]
    [function greet, ()[void]=>,
        std.print(line="*wags tail*");
    ];
];

[adapter B, ISpeak..Rat,
    [use speak, rat.squeak.[plain_genre].[overload ()[void]=>]];
];

[adapter B, IGreet..Rat,
    [use greet, Rat.squeak.[plain_genre].[overload ()[void]=>]];
];

[use A, B.[plain_genre].[overload ISpeak..Rat]];
[use A, B.[plain_genre].[overload IGreet..Rat]];

// could do with compile time loop instead...
// [static]
// [for B.[overload_range], [static] overload:=[value],
//    [use A, overload];
//];

[function [main], ()[signed_integer],
    dog := Dog();
    cat := Cat();
    rat := Rat();

    dog.[adapt A, ISpeak].speak();
    dog.[adapt A, IGreet].greet();
    cat.[adapt A, ISpeak].speak();
    cat.[adapt A, IGreet].greet();

    speakAndGreet(animal=dog.[compose A]);
    speakAndGreet(animal=cat.[compose A]);
    speakAndGreet(animal=rat.[compose A]);

    [result] <:= 0;
];

[function speakAndGreet, (> animal:[composition ISpeak, IGreet] <)[void],
    animal.[decompose ISpeak].speak();
    animal.[decompose IGreet].greet();
];