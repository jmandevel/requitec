[import "std", std];

[interface ISpeak,
    // this function is virtual so can be overriden by adapters
    // its not opaque, so it does not have to be overriden
    public virtual
    [function speak, ()Void=>,
        std.print(line="I don't speak.");
    ];

    // this function is not virtual so it cannot be overriden by adapters
    public
    [function doSomething, ()Void=>,
        std.print(line="do something now!");
    ];

];

[class Dog, public[layout_constructor]; {},];

[class Cat, public[layout_constructor]; {},];

[class Rat, public[layout_constructor]; {},
    public
    [function squeak, ()Void=>,
        std.print(line="Squeak!");  
    ];
];

[adapter A, Dog==>ISpeak,
    [public]
    [function speak, ()Void=>,
        std.print(line="Woof!");
    ];
];

[adapter A, Cat==>ISpeak,
    public
    [function speak, ()Void=>,
        std.print(line="Meow!");
    ];
];

[adapter A, Rat==>ISpeak,
    [use speak, Rat.squeak.[reflect].[resolve_function ()Void=>$]];
];

[interface IGreet,
    // virtual and opqaque, so there is no default implementation and adapters must implement it.
    public virtual opaque
    [function greet, ()Void=>];
];

[adapter A, Dog==>IGreet,
    public
    [function greet, ()Void=>,
        std.print(line="*wags tail*");
    ];
];

[adapter B, Dog==>IGreet,
    public
    [function greet, ()Void=>,
        std.print(line="bark!");
    ];
];

[main ()Int,
    dog := Dog();
    cat := Cat();
    rat := Rat();

    // use adapt to get interface of value.
    speak_adpater :var\$^^ISpeak= dog.[adapt A-->ISpeak].[borrow];
    speak_adpater.speak();
    // can reassign a different interface of same type
    speak_adapter = cat.[adapt A-->ISpeak].[borrow];
    speak_adapter.speak();

    // use compose to create composition of 1 or more interfaces
    dog_composition:$^^[composition ISpeak, IGreet]= dog.[compose A-->IGreet, A-->ISpeak].[borrow];
    // decompose a composition to get one of its interfaces
    dog_greet_adapter :$^^IGreet= dog_composition.[decompose IGreet].[borrow];
    dog_greet_adapter.greet();

    speakAndGreet(animal=dog.[compose A-->ISpeak, A-->IGreet]);
    speakAndGreet(animal=cat.[compose A-->ISpeak, A-->IGreet]);
    speakAndGreet(animal=rat.[compose A-->ISpeak, A-->IGreet]);

    [result] <:= 0;
];

[function speakAndGreet, (> animal:64^^[composition ISpeak, IGreet] <)void,
    animal.[decompose ISpeak].speak();
    animal.[decompose IGreet].greet();
];