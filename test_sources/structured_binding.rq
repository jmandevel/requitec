pure
[procedure multiReturn, ( a:SInt, b:SInt <)Split@{> div:SInt, mul:SInt <}, result,
    result.div <:= a / b;
    result.mul <:= a * b;
];

mangle::main
[procedure , ()SInt, result,
    // by name
    // in is a name for the returned value. since it is a split tuple, can store members in seperate local variables
    [split divided:= in.div, multiplied:= in.mul ] =in\\ multiReturn(0, 1);

    // by index
    [split divided = in.0, multiplied = in.1 ] =in\\ multiReturn(0, 1);

    // as tuple
    tuple := multiReturn(0, 1);

    // as split tuple
    [split { a:=in.0, b:=in.mul, c:=3 }] =in\\ multiReturn(0, 1);

    result <:= 0;
];