[import "std"];

[template]::{> List:[symbol] <}
[function printList, (> list:List <)[void],
    [spin list,
        [weave [value].[type].[is_string_type], str:=[value],
            ..std.print(line="found string: " +> substr);
        ][weave [value].[type].[is_integer_type], int:=[value],
            ..std.print(line="found integer: " +> int);    
        ][weave [value].[type].[is_float_type], float:=[value],
            ..std.print(line="found float: +> float);
        ][weave [true], any:=[value],
            ..std.print(line="found something else: " +> any.[borrow]);
        ];
    ];
];

[entry
    ..printList(
        "hello" +>
        3.14.[as [single]] +>
        0.[as[fast_signed_integer 32]] +>
        [true]);

    [result] := 0;
];