// Any is a special type that is usable only in prequite or for postquite vignettes of unrolled prequite loops.

// This variable can contain any type. set it to a SInt value first.
my_any :Any=0;
my_any = 3.14; // Now it contains a Single
my_any = true; // now it contains a Bool
is_boolean := my_any.[anytype].[is Bool]; 

[main ()SInt, result,
    my_tuple := { 1, 3.14, true, "Hello!" };
    pre [for my_tuple, var:Any=value,
        pre [if var.[anytype].[is INT],
            std.print(line="integer");
        ] pre [else_if var.[anytype].[is FLOAT],
            std.print(line="float");
        ] pre [else
            std.print(line="something else");
        ]
    ];
    result <:= 0;
];