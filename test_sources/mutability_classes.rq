[mutability_class ClassA];

@may_copy @may_move
[object Foo,
    {>
        @public @[mutable_with ClassA] a := 0,
        @public b := 0
    <}

    @public
    [constructor],
];

[entry_point
    foo :`= Foo(); // of type `Foo
    foo_borrow := foo.ClassA`[borrow]; // of type &ClassA`Foo

    foo_a.a += 1;
    // this is invalid
    // foo_a.b += 1;
];