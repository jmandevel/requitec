mangle::main
[procedure , ()SInt, result,
    // high and modifiers are compile time values

    pre modifier := pre;

    // the modifier stored in modifier is ascribed to the variable qualifier
    modifier qualifier := mut;

    my_mut_variable :qualifier\= 0;
    my_mut_variable = 1;

    result <:= my_mut_variable;
];

// equivalent to deducing this in c++

[class NumContainer,
    {| num := 0 },

    public [layout_constructor];

    // if reciever is mut, return is ref to mut. is reciver is no_mut, return is ref to no_mut.
    public template::{| auto mut0:MUT }
    pure
    [procedure getNumRef, ()Ref@mut0\SInt=>Ref@mut0\, result,
        result <:= this.num.mut0\[ref]
    ];

];