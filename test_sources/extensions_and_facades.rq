
[table example,
    @template::{> Type:[type], LENGTH:[unsigned_index] <}
    [extension_function getElementCount, LENGTH#Type, (><)[unsigned_index],
        [result] := LENGTH;
    ];

    @template::{> Type:[type], LENGTH:[unsigned_index] <}
    [extension_method getElementCount, &LENGTH#Type=>(><)[unsigned_index],
        [result] := LENGTH;
    ];

    @auto_drop
    [class Foo,];

    [extension_method bar, &Foo=>(><)[void],
    
    ];
];

[entry
    my_array :5#[signed]= [[0, 1, 2, 3, 4]].[of [signed_fast_bits 32]];

    // call extension function
    {} = my_array.[type]->.example.getElementCount();
    // call extension method
    {} = my_array.[borrow]->.example.getElementCount();
    
    // construct variable of type declared in same table as extension functions
    foo := .example.Foo();

    // call extension function
    foo.[borrow]->.example.bar();

    // apply facades
    [facade &5#[signed], .example.getElementCount];
    [facade &.example.Foo, .example.bar];

    // call extension function
    {} = my_array.[type]->getElementCount();
    // call extension method
    {} = my_array.[borrow]->getElementCount();

    // call extension function
    foo.[borrow]->bar();
];