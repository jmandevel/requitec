[import "std"];

[may_parent][implicit_drop][may_copy]
[class Grandparent,

    [public][abstract]
    [method myMeth, ()[void]=>$,];
];

[may_parent][implicit_drop][may_copy]
[class Parent,
    {|
        [inherit] parent := ..Grandparent();
    },

    [public][override]::parent.myMeth
    [method myMeth, ()[void]=>$,
        ..std.print(line="in parent");
    ];
    
    [virtual]
    [method myMethB, ()[void]=>$,
        ..std.print(line="in parent");
    ];
];

[implicit_drop][may_copy]
[class Child,
    {| 
        [inherit] parent := ..Parent() 
    },
    
    [public]
    [use_method myMeth, parent.myMeth, ()[void]=>$];
    
    [public]
    [override]::parent.myMethB
    [method myMethB, ()[void]=>$,
        ..std.print(line="in child");
    ];
];

[entry
    child := ..Child();
    parent := child.[dynamic_cast ..Parent].[borrow];
    grandparent := parent.[dynamic_cast ..Grandparent].[borrow];

    parent.[borrow].myMeth();
    child.[borrow].myMeth();
    grandparent.[borrow].myMeth();
    parent.[borrow].myMethB();
    child.[borrow].myMethB();
    grandparent.[borrow].myMethB();

    [result] := 0;
];