[import "std"];
[facade std];

@may_parent
[object Parent,
    
    [method myFunc, &=>(><),
        std.print(line="in parent");
    ];
    
    @virtual
    [method myFuncB, &=>(><),
        std.print(line="in parent");
    ];
    
    [constructor];
];

[object Child,
    {> 
        @parent parent := Parent() 
    <},
    
    [use [self].parent.myFunc];
    
    @[override [self].parent.myFuncB]
    [method myFuncB, &=>(><),
        std.print(line="in child");
    ];

    [constructor];
];

[entry_point
    parent := Parent();
    child := Child();

    parent.[borrow].myFunc();
    child.[borrow].myFunc();
    parent.[borrow].myFuncB();
    child.[borrow].myFuncB();
];