[import "std"];
[facade std];

@may_parent
[class Parent,
    
    [method myFunc, &=>(><),
        std.print(line="in parent");
    ];
    
    @virtual
    [method myFuncB, &=>(><),
        std.print(line="in parent");
    ];
    
    [constructor];
];

[class Child,
    {> 
        @parent parent := Parent() 
    <},
    
    @public
    [use [this_type].parent.myFunc];
    
    @public
    @override..[this_type].parent.myFuncB
    [method myFuncB, &=>(><),
        std.print(line="in child");
    ];

    @public 
    [constructor];
];

[entry_point
    parent := Parent();
    child := Child();

    parent.[borrow].myFunc();
    child.[borrow].myFunc();
    parent.[borrow].myFuncB();
    child.[borrow].myFuncB();
];