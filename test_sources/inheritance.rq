[import "std"];

@may_parent
[class Parent,
    
    [method myFunc, &=>(><),
        .std.print(line="in parent"ascii);
    ];
    
    @virtual
    [method myFuncB, &=>(><),
        .std.print(line="in parent"ascii);
    ];
    
    [constructor];
];

[class Child,
    {> 
        @parent parent := .Parent() 
    <},
    
    @public
    [use [this_type].parent.myFunc];
    
    @public
    @override::[this_type].parent.myFuncB
    [method myFuncB, &=>(><),
        .std.print(line="in child");
    ];

    @public 
    [constructor];
];

[entry
    parent := .Parent();
    child := .Child();

    parent.[borrow].myFunc();
    child.[borrow].myFunc();
    parent.[borrow].myFuncB();
    child.[borrow].myFuncB();
];