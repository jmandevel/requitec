[import "std"];

@may_parent @auto_drop @may_copy
[class Parent,
    
    [method myFunc, &=>(><),
        .std.print(line="in parent");
    ];
    
    @virtual
    [method myFuncB, &=>(><),
        .std.print(line="in parent");
    ];
];

@auto_drop @may_copy
[class Child,
    {> 
        @parent parent := .Parent() 
    <},
    
    @public
    [use parent.myFunc];
    
    @public
    @override::parent.myFuncB
    [method myFuncB, &=>(><),
        .std.print(line="in child");
    ];
];

[entry
    parent := .Parent();
    child := .Child();

    parent.[borrow].myFunc();
    child.[borrow].myFunc();
    parent.[borrow].myFuncB();
    child.[borrow].myFuncB();
];