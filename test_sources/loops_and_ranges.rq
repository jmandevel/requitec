[import "std"];

[entry

    // all of these loops are equivalent

    // equal limit interval
    [for 0s32f.==9, value:=[value],
        .std.print(line="value is {value}");    
    ]

    // less limit interval
    [for 0s32f.<10, value:=[value], 
        .std.print(line="value is {value}");    
    ];

    // interval
    [for 0s32f.<10.+1, value:=[value], 
        .std.print(line="value is {value}");    
    ]

    [scope
        // while loop    
        value :`= 0s32f;
        [while value < 10,
            .std.print(line="value is {value}");   
            value = value + 1;
        ];
    ];

    // element range
    [for [[0s32f, 1, 2, 3, 4, 5, 6, 7, 8, 9]], value:=[value],     
        .std.print(line="value is {value}");
    ];

    // ranger range
    [class MyClass,
        {> 
            @public data:=[[0s32f, 1, 2, 3, 4, 5, 6, 7, 8, 9]] 
        <},

        @public
        [constructor];

        @public
        [ranger [signed],
            [for [this].data, value:=[value], 
              [range_over 
                value
              ];
            ];
        ];
    ];
    class := MyClass();
    [for class.[borrow], value:=[value], 
        .std.print(line="value is {value}");
    ];

    [if (0s32f.<10).[borrow]->getContains(5),
        .std.print(line="5 is within interval over 0 to 10");
    ];
];