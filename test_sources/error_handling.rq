@message::"divide by 0 error"
[code ERROR_DIVIDE_BY_ZERO];
@message::"no error"
[code OK];

// @no_error_result makes it so when an error occurs, there is no result returned from procedure
// if this is the case, then control flow must jump on error or result variable must go unused/ignored
@no_error_result 
[category DivideResult,
    @ok OK, // ok attribute means that this code is not an error and will pass
    ERROR_DIVIDE_BY_ZERO
];

[entry
    divide_result := divide(10, 5)
        .[pass code:=[value], 
            .std.print(line="no error occured: {code.[message]}.");
        ].[fail code:=[value], 
            .std.print(line="an error occured: {code.[message]}");
            [result] := 1;
            [return];
        ];
    [result] := 0;
];

@template::{> Type:[float] <}
[function divide, (> a:Type, b:Type <)Type ?.DivideResult,
    [if b == 0,
        [status] := .ERROR_DIVIDE_BY_ZERO;
        [return];
    ];
    [result] := a / b;
    [status] := .OK;
    [return];
];