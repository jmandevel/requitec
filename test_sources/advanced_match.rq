[enumeration enum,
    float:[binary32];
    int:[signed];
    str:^[utf8];
]

val := enum.float(1.234);

result :=
    [inline_match val,
        [case float,
            [out] := float;
        ][case int,
            [out] := [binary32]:int;
        ][default
            [out] := 0;
        ]
    ];